{
  "expo": {
    "name": "SentraSense",
    "slug": "sentrasense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/SentraShield.png",
    "scheme": "sentrasense",
    "userInterfaceStyle": "automatic",

    "assetBundlePatterns": ["assets/**/*"],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sentrasense.app"
    },
    "android": {
      "package": "com.sentrasense.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/SentraShield.png",
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-vosk",
        {
          "models": ["assets/model-sv-rhasspy-0.15"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/SentraSenseLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f0bf9fe-55a7-46d7-8609-997d89dbad75"
      }
    },
    "owner": "sentrasense"
  }
}